rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    match /passenger_profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name'])
        && request.resource.data.uid == uid
        && shortText(request.resource.data.name, 30);
      allow update, delete: if false;
    }
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','text','time','uid'])
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.name, 30)
        && shortText(request.resource.data.text, 300)
        && request.resource.data.time is int
        && request.resource.data.time <= request.time.toMillis()
        && request.resource.data.time > request.time.toMillis() - 60000;
      allow update, delete: if false;
    }
    match /sightings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['lat','lon','time','option','uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lat is number
        && request.resource.data.lon is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
        && request.resource.data.option is int
        && request.resource.data.option >= 0 && request.resource.data.option <= 2
        && request.resource.data.time is int
        && request.resource.data.time <= request.time.toMillis()
        && request.resource.data.time > request.time.toMillis() - 60000;
      allow update, delete: if false;
    }
    match /app_feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['category','message','uid','createdAt','status'])
        && request.resource.data.keys().hasOnly(['category','message','uid','createdAt','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['Sugerencia','Reclamo','Error de la aplicación']
        && shortText(request.resource.data.message, 1000)
        && request.resource.data.message.size() >= 10
        && request.resource.data.status == 'nuevo'
        && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
